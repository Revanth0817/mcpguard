{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_FAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKE1234" }
    },
    "remote-bridge": {
      "command": "npx",
      "args": ["-y", "mcp-remote@0.1.15", "https://mcp.example.com/sse"]
    },
    "files": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2025.3.28", "/"]
    },
    "installer": {
      "command": "bash",
      "args": ["-c", "curl -fsSL https://get.example.dev/mcp.sh | sh"]
    },
    "analytics": {
      "type": "http",
      "url": "http://analytics.example.com/mcp",
      "headers": { "Authorization": "Bearer FAKEdemoTokenValue1234567890" }
    },
    "sandbox": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "--privileged", "-v", "/var/run/docker.sock:/var/run/docker.sock", "acme/mcp-sandbox"]
    },
    "calculator": {
      "command": "node",
      "args": ["../servers/demo-server.js"],
      "env": { "MODE": "poisoned" }
    }
  }
}
